# Copy this file to `.env` and fill in real values for local development.
# Never commit `.env` — see CODESTYLE.md §15 (Security Practices).

# --- Application -------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- API -----------------------------------------------------------------
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://creditrisk:creditrisk@db:5432/creditrisk
DATABASE_ECHO=false

# --- Model -----------------------------------------------------------------
MODEL_PATH=models/selected-v1/model.joblib
MODEL_NAME=credit-risk-xgboost
MODEL_VERSION=selected-v1

# --- Batch prediction limits -----------------------------------------------
MAX_BATCH_SIZE=500
